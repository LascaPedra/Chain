 if ok and direct then return direct end
 local ok2,children=pcall(function()return parent:GetChildren()end)
 if not ok2 or not children then return nil end
 local lower=string.lower(name)
 for _i=1,#children do
  if string.lower(children[_i].Name)==lower then return children[_i] end
 end
 return nil
end

local function findDeep(root,name)
 if not root then return nil end
 local lower=string.lower(name)
 local ok,list=pcall(function()return root:GetDescendants()end)
 if not ok or not list then return nil end
 for _i=1,#list do
  if string.lower(list[_i].Name)==lower then return list[_i] end
 end
 return nil
end

