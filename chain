local S = 1
local BASE_KEY, DKEY, c1, c2, src
local B91C, B91D, NONCE

while S ~= 0 do
    if S == 1 then
        B91C = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'()*+,./:;<=>?@[]^_`{|}~"
        B91D = {}
        for i = 1, #B91C do B91D[_SS(B91C, i, i)] = i - 1 end
        NONCE = "A1B2C3D4E5F6"
        S = 2

    elseif S == 2 then
        local kb = {}
        for i = 1, 32 do
            local ai = tonumber(_SS(A, (i-1)*2+1, (i-1)*2+2), 16) or 0
            local bi = tonumber(_SS(B, (i-1)*2+1, (i-1)*2+2), 16) or 0
            kb[i] = _SC(XT[ai][bi])
        end
        BASE_KEY = _TC(kb)
        S = 3

    elseif S == 3 then
        local uid = game:GetService("Players").LocalPlayer.UserId
        local kb = {}
        for i = 1, 32 do
            local b = _SB(BASE_KEY, i)
            local shift = (uid + i * 13) % 256
            kb[i] = _SC(XT[b][shift])
        end
        DKEY = _TC(kb)
        S = 4

    elseif S == 4 then
        local bytes = {}
        for i = 1, #P, 2 do
            local c1v = B91D[_SS(P, i, i)] or 0
            local c2v = B91D[_SS(P, i+1, i+1)] or 0
            local b = c1v + c2v * 91
            if b > 255 then b = b % 256 end
            bytes[#bytes+1] = _SC(b)
        end
        c2 = _TC(bytes)
        S = 5

    elseif S == 5 then
        local out = {}
        for i = 1, #c2 do
            local b = _SB(c2, i)
            local k = ((i * 37 + 11) % 256)
            out[i] = _SC(XT[b][k])
        end
        c1 = _TC(out)
        S = 6

    elseif S == 6 then
        src = _cc20(c1, DKEY, NONCE)
        S = 7

    elseif S == 7 then
        if loadstring ~= _LS then return end
        if math.floor ~= _MF then return end
        if string.char ~= _SC then return end
        local fn = _LS(src)
        if type(fn) == "function" then fn() end
        S = 0
    end
end
