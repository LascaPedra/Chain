local function xorBytes(s)
    local out = {}
    for i = 1, #s do
        local b = string.byte(s, i)
        local k = ((i * 37 + 11) % 256)
        local r, p, a, bb = 0, 1, b, k
        while a > 0 or bb > 0 do
            if a % 2 ~= bb % 2 then r = r + p end
            a = math.floor(a / 2); bb = math.floor(bb / 2); p = p * 2
        end
        out[i] = string.char(r)
    end
    return table.concat(out)
end

local function lzwDecompress(input)
    local dict = {}
    for i = 0, 255 do dict[i] = string.char(i) end
    local nextCode, codeWidth, maxCode = 256, 9, 511
    local output = {}
    local bitBuf, bitCnt, pos, total = 0, 0, 1, #input
    
    local function readCode()
        while bitCnt < codeWidth and pos <= total do
            bitBuf = bitBuf + string.byte(input, pos) * (2 ^ bitCnt)
            bitCnt = bitCnt + 8
            pos = pos + 1
        end
        if bitCnt < codeWidth then return nil end
        local code = bitBuf % (2 ^ codeWidth)
        bitBuf = math.floor(bitBuf / (2 ^ codeWidth))
        bitCnt = bitCnt - codeWidth
        return code
    end
    
    local prev = nil
    while true do
        local code = readCode()
        if code == nil then break end
        local entry
        if dict[code] then
            entry = dict[code]
        elseif code == nextCode and prev then
            entry = prev .. prev:sub(1, 1)
        else
            break
        end
        output[#output + 1] = entry
        if prev then
            if nextCode < 4096 then
                dict[nextCode] = prev .. entry:sub(1, 1)
                nextCode = nextCode + 1
                if nextCode >= maxCode then
                    codeWidth = codeWidth + 1
                    maxCode = maxCode * 2 + 1
                end
            end
        end
        prev = entry
    end
    return table.concat(output)
end

local function fromHex(hex)
    local out = {}
    for i = 1, #hex, 2 do
        out[#out + 1] = string.char(tonumber(hex:sub(i, i + 1), 16))
    end
    return table.concat(out)
end

local PAYLOAD = ""

if #PAYLOAD < 50 then
    warn("hello world, neural was here")
    return
end

local compressed = fromHex(PAYLOAD)
local decompressed = lzwDecompress(xorBytes(compressed))
local fn = loadstring(decompressed)

if type(fn) ~= "function" then
    warn("hello world")
    return
end

fn()
